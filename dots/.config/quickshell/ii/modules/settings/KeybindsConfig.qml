import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import qs.services
import qs.modules.common
import qs.modules.common.widgets

ContentPage {
    id: page
    forceWidth: true

    readonly property string mainPath: Directories.config + "/hypr/hyprland/keybinds.lua"
    readonly property string customPath: Directories.config + "/hypr/custom/keybinds.lua"
    readonly property string captureSubmap: "qs_keybind_capture"

    property var entries: []
    property var filtered: []
    property var fileTexts: ({})
    property string query: ""

    property bool editorOpen: false
    property bool saving: false
    property string saveMessage: ""
    property string pendingText: ""
    property bool capturing: false
    property var editingEntry: null
    property string capturedCombo: ""
    property string captureError: ""

    // Find the last line of the hl.bind(...) call starting at `start`.
    // Parentheses inside string literals don't count; a call can span
    // several lines (dispatcher on one line, options table on the next).
    function statementEndLine(lines, start) {
        let depth = 0;
        let started = false;
        let inString = false;
        let escaped = false;
        const limit = lines.length - 1;
        for (let li = start; li <= limit; li++) {
            const line = lines[li];
            for (let ci = 0; ci < line.length; ci++) {
                const ch = line[ci];
                if (inString) {
                    if (escaped)
                        escaped = false;
                    else if (ch === "\\")
                        escaped = true;
                    else if (ch === "\"")
                        inString = false;
                    continue;
                }
                if (ch === "\"")
                    inString = true;
                else if (ch === "(") {
                    depth++;
                    started = true;
                } else if (ch === ")") {
                    depth--;
                    if (started && depth === 0)
                        return li;
                }
            }
        }
        return limit;
    }

    function parseLua(path, text) {
        const result = [];
        if (!text)
            return result;
        const lines = text.split("\n");
        const bindRegex = /^\s*hl\.bind\(\s*"([^"]+)"/;
        const descriptionRegex = /description\s*=\s*"((?:\\.|[^"\\])*)"(\s*\.\.)?/;
        for (let i = 0; i < lines.length; i++) {
            const match = lines[i].match(bindRegex);
            if (!match)
                continue;
            const endLine = statementEndLine(lines, i);
            const statement = lines.slice(i, endLine + 1).join("\n");
            const descriptionMatch = statement.match(descriptionRegex);
            let description = descriptionMatch ? descriptionMatch[1] : "";
            if (descriptionMatch) {
                try { description = JSON.parse('"' + description + '"'); } catch (_) {}
            }
            if (descriptionMatch && descriptionMatch[2])
                description += "…"; // Description is built by concatenation
            // A bind whose combo string is concatenated with something
            // (`"SUPER + " .. key[i]`) is generated by a loop. Its combo is
            // not a literal, so it must never be edited as one.
            // Note: no trimStart() here — Qt's JS engine doesn't have it,
            // and throwing inside parseLua leaves the page empty.
            const rest = lines[i].slice(match[0].length).replace(/^\s+/, "");
            const dynamic = !rest.startsWith(",") && !rest.startsWith(")");
            result.push({
                            path: path,
                            line: i,
                            combo: match[1],
                            description: description,
                            statement: statement,
                            dynamic: dynamic
                        });
            i = endLine;
        }
        return result;
    }

    function displayCombo(entry) {
        if (!entry)
            return "";
        return entry.dynamic ? entry.combo.replace(/\s+$/, "") + " …" : entry.combo;
    }

    function rebuild() {
        let list = parseLua(mainPath, fileTexts[mainPath] || "").concat(parseLua(customPath,
                                                                                 fileTexts[customPath]
                                                                                 || ""));
        const names = {};
        for (const entry of list) {
            if (entry.description)
                names[normalizeCombo(entry.combo)] = entry.description;
        }
        const unbound = [];
        const custom = fileTexts[customPath] || "";
        const pattern = /^\s*hl\.unbind\(\s*"([^"]+)"\s*\)/gm;
        let match;
        while ((match = pattern.exec(custom)) !== null)
            unbound.push(normalizeCombo(match[1]));
        list = list.filter(entry => entry.path !== mainPath || !unbound.includes(normalizeCombo(
                                                                                     entry.combo)));
        for (const entry of list) {
            entry.description = entry.description || names[normalizeCombo(entry.combo)] || inferredName(
                        entry.statement);
        }
        entries = list;
        applyFilter();
    }

    function applyFilter() {
        const q = query.trim().toLowerCase();
        filtered = q === "" ? entries : entries.filter(e => (e.combo + " " + e.description).toLowerCase(
                                  ).includes(q));
    }

    onQueryChanged: applyFilter()

    function normalizeCombo(combo) {
        const parts = combo.split("+").map(part => part.trim().toUpperCase());
        const key = parts.pop() || "";
        parts.sort();
        return parts.join(" + ") + " + " + key.toUpperCase();
    }

    function isModifierKey(key) {
        return key === Qt.Key_Shift || key === Qt.Key_Control || key === Qt.Key_Alt || key === Qt.Key_Meta
                || key === Qt.Key_Super_L || key === Qt.Key_Super_R || key === Qt.Key_Hyper_L || key
                === Qt.Key_Hyper_R || key === Qt.Key_CapsLock;
    }

    function keyName(event) {
        const key = event.key;
        if (key >= Qt.Key_A && key <= Qt.Key_Z)
            return String.fromCharCode(key);
        if (key >= Qt.Key_0 && key <= Qt.Key_9)
            return String.fromCharCode(key);
        if (key >= Qt.Key_F1 && key <= Qt.Key_F24)
            return "F" + (key - Qt.Key_F1 + 1);

        switch (key) {
        case Qt.Key_Space:
            return "Space";
        case Qt.Key_Tab:
            return "Tab";
        case Qt.Key_Return:
        case Qt.Key_Enter:
            return "Return";
        case Qt.Key_Backspace:
            return "BackSpace";
        case Qt.Key_Delete:
            return "Delete";
        case Qt.Key_Insert:
            return "Insert";
        case Qt.Key_Home:
            return "Home";
        case Qt.Key_End:
            return "End";
        case Qt.Key_PageUp:
            return "Page_Up";
        case Qt.Key_PageDown:
            return "Page_Down";
        case Qt.Key_Left:
            return "Left";
        case Qt.Key_Right:
            return "Right";
        case Qt.Key_Up:
            return "Up";
        case Qt.Key_Down:
            return "Down";
        case Qt.Key_Slash:
            return "Slash";
        case Qt.Key_Question:
            return "question";
        case Qt.Key_Period:
            return "Period";
        case Qt.Key_Greater:
            return "greater";
        case Qt.Key_Comma:
            return "Comma";
        case Qt.Key_Less:
            return "less";
        case Qt.Key_Semicolon:
            return "Semicolon";
        case Qt.Key_Colon:
            return "colon";
        case Qt.Key_Apostrophe:
            return "Apostrophe";
        case Qt.Key_QuoteDbl:
            return "quotedbl";
        case Qt.Key_Backslash:
            return "Backslash";
        case Qt.Key_Bar:
            return "bar";
        case Qt.Key_Minus:
            return "Minus";
        case Qt.Key_Underscore:
            return "underscore";
        case Qt.Key_Equal:
            return "Equal";
        case Qt.Key_Plus:
            return "plus";
        case Qt.Key_BracketLeft:
            return "BracketLeft";
        case Qt.Key_BraceLeft:
            return "braceleft";
        case Qt.Key_BracketRight:
            return "BracketRight";
        case Qt.Key_BraceRight:
            return "braceright";
        case Qt.Key_QuoteLeft:
            return "Grave";
        case Qt.Key_AsciiTilde:
            return "asciitilde";
        case Qt.Key_Exclam:
            return "exclam";
        case Qt.Key_At:
            return "at";
        case Qt.Key_NumberSign:
            return "numbersign";
        case Qt.Key_Dollar:
            return "dollar";
        case Qt.Key_Percent:
            return "percent";
        case Qt.Key_AsciiCircum:
            return "asciicircum";
        case Qt.Key_Ampersand:
            return "ampersand";
        case Qt.Key_Asterisk:
            return "asterisk";
        case Qt.Key_ParenLeft:
            return "parenleft";
        case Qt.Key_ParenRight:
            return "parenright";
        case Qt.Key_Print:
            return "Print";
        case Qt.Key_ScrollLock:
            return "Scroll_Lock";
        case Qt.Key_Pause:
            return "Pause";
        case Qt.Key_Menu:
            return "Menu";
        case Qt.Key_MediaPlay:
            return "XF86AudioPlay";
        case Qt.Key_MediaPause:
            return "XF86AudioPause";
        case Qt.Key_MediaStop:
            return "XF86AudioStop";
        case Qt.Key_MediaNext:
            return "XF86AudioNext";
        case Qt.Key_MediaPrevious:
            return "XF86AudioPrev";
        case Qt.Key_MediaRecord:
            return "XF86AudioRecord";
        case Qt.Key_MediaTogglePlayPause:
            return "XF86AudioPlay";
        case Qt.Key_VolumeUp:
            return "XF86AudioRaiseVolume";
        case Qt.Key_VolumeDown:
            return "XF86AudioLowerVolume";
        case Qt.Key_VolumeMute:
            return "XF86AudioMute";
        case Qt.Key_MonBrightnessUp:
            return "XF86MonBrightnessUp";
        case Qt.Key_MonBrightnessDown:
            return "XF86MonBrightnessDown";
        case Qt.Key_LaunchMail:
            return "XF86Mail";
        case Qt.Key_Calculator:
            return "XF86Calculator";
        default:
            return "";
        }
    }

    function comboFromEvent(event) {
        const mods = [];
        if (event.modifiers & Qt.MetaModifier)
            mods.push("SUPER");
        if (event.modifiers & Qt.ControlModifier)
            mods.push("CTRL");
        if (event.modifiers & Qt.AltModifier)
            mods.push("ALT");
        if (event.modifiers & Qt.ShiftModifier)
            mods.push("SHIFT");
        const key = keyName(event);
        if (key === "")
            return "";
        if (mods.length === 0) {
            // Unmodified keys are only accepted if they can't be mistaken
            // for typing: function keys, media/brightness keys, and a few
            // standalone special keys. Plain letters/digits need a modifier.
            const standalone = /^F([1-9]|1[0-9]|2[0-4])$/.test(key) || key.startsWith("XF86") || ["Print",
                                                                                                  "Scroll_Lock",
                                                                                                  "Pause", "Insert",
                                                                                                  "Menu"].indexOf(
                      key) !== -1;
            if (!standalone)
                return "";
        }
        return mods.concat([key]).join(" + ");
    }

    function handleKey(event) {
        if (!capturing)
            return;
        event.accepted = true;
        if (event.isAutoRepeat)
            return;
        if (event.key === Qt.Key_Escape) {
            stopCapture();
            return;
        }
        if (isModifierKey(event.key))
            return;
        const combo = comboFromEvent(event);
        if (combo === "") {
            captureError = Translation.tr("Unsupported key");
            capturedCombo = "";
            return;
        }
        // Duplicated combos are used deliberately in this config (a
        // quickshell action plus a fallback command on the same keys, or a
        // custom override of a shipped bind). Re-applying the combo an entry
        // already belongs to is not a conflict; taking over a *different*
        // bind's combo is.
        const ownCombo = editingEntry ? normalizeCombo(editingEntry.combo) : "";
        const target = normalizeCombo(combo);
        const conflict = entries.find(e => e !== editingEntry && !e.dynamic && normalizeCombo(e.combo) === target
                                           && target !== ownCombo);
        capturedCombo = combo;
        stopCapture();
        captureError = conflict ? Translation.tr("Already used by \"%1\"").arg(conflict.description
                                                                               || conflict.combo) : "";
    }

    function inferredName(statement) {
        const action = statement.match(/hl\.dsp\.(\w+)\(\s*(?:"((?:\\.|[^"\\])*)")?/);
        if (!action)
            return Translation.tr("Custom Lua action");
        const names = {
            exec_cmd: "Run",
            global: "Shell",
            kill_active: "Close window",
            toggle_floating: "Toggle floating",
            fullscreen: "Fullscreen",
            move_focus: "Move focus",
            move_window: "Move window",
            workspace: "Switch workspace",
            move_to_workspace: "Move to workspace",
            submap: "Switch shortcut mode"
        };
        const label = names[action[1]] || action[1].replace(/_/g, " ");
        let argument = action[2] || "";
        if (action[1] === "global")
            argument = argument.replace(/^quickshell:/, "").replace(/([a-z])([A-Z])/g, "$1 $2");
        return argument ? label + ": " + argument : label;
    }

    function stopCapture() {
        if (!capturing)
            return;
        capturing = false;
        capturePollTimer.stop();
        submapReset.running = true;
    }

    function startEdit(entry) {
        if (saving || (entry && entry.dynamic))
            return;
        stopCapture();
        editingEntry = entry;
        capturedCombo = entry ? entry.combo : "";
        captureError = "";
        saveMessage = "";
        nameField.value = entry ? descriptionName(entry.description) : "";
        commandField.value = "";
        editorOpen = true;
        page.contentY = 0;
    }

    function closeDialog() {
        stopCapture();
        editorOpen = false;
        editingEntry = null;
    }

    onVisibleChanged: if (!visible)
                          stopCapture()
    Component.onDestruction: if (capturing)
                                 Quickshell.execDetached(["hyprctl", "dispatch", 'hl.dsp.submap("reset")'])

    function replaceCombo(statement, combo) {
        return statement.replace(/^(\s*hl\.bind\(\s*")[^"]*(")/, (match, prefix, suffix) => prefix + combo + suffix);
    }

    function comboError(combo) {
        if (!/^(?:(?:SUPER|CTRL|ALT|SHIFT)\s*\+\s*)*(?:[A-Za-z0-9_]+|mouse:[0-9]+)$/.test(combo))
            return Translation.tr("Use a shortcut such as SUPER + SHIFT + T.");
        const own = editingEntry ? normalizeCombo(editingEntry.combo) : "";
        const target = normalizeCombo(combo);
        const conflict = entries.find(e => !e.dynamic && normalizeCombo(e.combo) === target && target
                                           !== own);
        return conflict ? Translation.tr("Already used by %1").arg(descriptionName(conflict.description)) :
                          "";
    }

    function applyRebind() {
        if (saving)
            return;
        stopCapture();
        const combo = capturedCombo.trim();
        captureError = comboError(combo);
        if (captureError)
            return;
        let customText = fileTexts[customPath] || "";
        if (editingEntry && editingEntry.path === customPath) {
            const lines = customText.split("\n");
            const count = editingEntry.statement.split("\n").length;
            if (lines.slice(editingEntry.line, editingEntry.line + count).join("\n")
                    !== editingEntry.statement) {
                captureError = Translation.tr("Bindings changed. Reopen the editor and try again.");
                return;
            }
            lines.splice(editingEntry.line, count, replaceCombo(editingEntry.statement, combo));
            customText = lines.join("\n");
        } else {
            if (!customText.endsWith("\n"))
                customText += "\n";
            if (editingEntry) {
                const group = entries.filter(e => e.path === mainPath && !e.dynamic && normalizeCombo(e.combo)
                                                  === normalizeCombo(editingEntry.combo));
                // Keep every action and its original options when moving a shipped shortcut.
                customText += `hl.unbind(${JSON.stringify(editingEntry.combo)})\n`;
                customText += group.map(e => replaceCombo(e.statement, combo)).join("\n") + "\n";
            } else {
                if (!nameField.value.trim() || !commandField.value.trim()) {
                    captureError = Translation.tr("Enter a name and command.");
                    return;
                }
                customText += `hl.bind(${JSON.stringify(combo)}, hl.dsp.exec_cmd(${JSON.stringify(
                            commandField.value.trim())}), { description = ${JSON.stringify(
                            nameField.value.trim())} })\n`;
            }
        }
        pendingText = customText;
        saving = true;
        customFile.setText(customText);
    }

    function descriptionName(description) {
        if (description === "")
            return Translation.tr("Custom bind");
        const index = description.indexOf(":");
        return index > 0 ? description.slice(index + 1).trim() : description;
    }

    function descriptionCategory(description) {
        const index = description.indexOf(":");
        return index > 0 ? description.slice(0, index).trim() : "";
    }

    function fileName(path) {
        return path === mainPath ? "keybinds.lua" : "custom/keybinds.lua";
    }

    Component.onCompleted: {
        mainFile.reload();
        customFile.reload();
    }

    FileView {
        id: mainFile
        path: Qt.resolvedUrl(page.mainPath)
        blockLoading: true
        watchChanges: true
        onFileChanged: reload()
        onLoaded: {
            page.fileTexts = Object.assign({}, page.fileTexts, {
                                               [page.mainPath]: mainFile.text()
                                           });
            page.rebuild();
        }
        onLoadFailed: error => console.warn("[Keybinds] Failed to load " + page.mainPath + ": " + error)
    }

    FileView {
        id: customFile
        path: Qt.resolvedUrl(page.customPath)
        blockLoading: true
        atomicWrites: true
        watchChanges: true
        onFileChanged: if (!page.saving)
                           reload()
        onSaved: {
            page.fileTexts = Object.assign({}, page.fileTexts, {
                                               [page.customPath]: page.pendingText
                                           });
            page.saving = false;
            page.rebuild();
            page.closeDialog();
            page.saveMessage = Translation.tr("Shortcut saved. Reloading Hyprland…");
            reloadTimer.restart();
        }
        onSaveFailed: error => {
            page.saving = false;
            page.captureError = Translation.tr("Could not save keybinds (error %1).").arg(error);
        }
        onLoaded: {
            page.fileTexts = Object.assign({}, page.fileTexts, {
                                               [page.customPath]: customFile.text()
                                           });
            page.rebuild();
        }
        onLoadFailed: error => console.warn("[Keybinds] Failed to load " + page.customPath + ": " + error)
    }

    Process {
        id: submapEnter
        // This config drives Hyprland through its Lua API, so dispatchers use hl.dsp
        command: ["hyprctl", "dispatch", `hl.dsp.submap("${page.captureSubmap}")`]
        onExited: code => {
            // Only start checking once the submap is actually active,
            // otherwise the first poll races the compositor and cancels the dialog.
            // If entering failed, keep the dialog open and rely on the local key handler.
            if (page.capturing && code === 0)
                capturePollTimer.restart();
            else if (code === 0) submapReset.running = true;
        }
    }

    Process {
        id: submapReset
        command: ["hyprctl", "dispatch", 'hl.dsp.submap("reset")']
    }

    Process {
        id: submapCheck
        command: ["hyprctl", "submap"]
        stdout: StdioCollector {
            onStreamFinished: {
                if (page.capturing && text.trim() !== page.captureSubmap)
                    page.stopCapture();
            }
        }
    }

    Timer {
        id: capturePollTimer
        interval: 400
        repeat: true
        running: false
        onTriggered: {
            if (!submapCheck.running)
                submapCheck.running = true;
        }
    }

    Process {
        id: reloadProc
        command: ["hyprctl", "reload"]
        onExited: code => page.saveMessage = code === 0 ? Translation.tr(
                                                              "Shortcut saved and Hyprland reloaded.") :
                                                          Translation.tr(
                                                              "Saved, but Hyprland reload failed. Check your configuration.")
    }

    Timer {
        id: reloadTimer
        interval: 300
        repeat: false
        onTriggered: reloadProc.running = true
    }

    ContentSection {
        icon: "keyboard"
        title: Translation.tr("Keybinds")

        RowLayout {
            Layout.fillWidth: true
            spacing: 8

            Rectangle {
                Layout.fillWidth: true
                implicitHeight: 38
                radius: Appearance.rounding.full
                color: Appearance.colors.colLayer1

                RowLayout {
                    anchors.fill: parent
                    anchors.leftMargin: 12
                    anchors.rightMargin: 10
                    spacing: 6

                    MaterialSymbol {
                        text: "search"
                        iconSize: 18
                        color: Appearance.colors.colSubtext
                    }

                    TextField {
                        id: searchField
                        Layout.fillWidth: true
                        padding: 0
                        background: Item {}
                        placeholderText: Translation.tr("Search keybinds")
                        placeholderTextColor: Appearance.colors.colSubtext
                        color: Appearance.colors.colOnLayer1
                        font {
                            family: Appearance.font.family.main
                            pixelSize: Appearance.font.pixelSize.small
                        }
                        onTextChanged: page.query = text
                    }
                }
            }

            RippleButtonWithIcon {
                objectName: "addKeybind"
                materialIcon: "add"
                mainText: Translation.tr("Add")
                enabled: !page.saving
                onClicked: page.startEdit(null)
            }
        }

        StyledText {
            text: Translation.tr("%1 shortcuts").arg(page.filtered.length)
            font.pixelSize: Appearance.font.pixelSize.smaller
            color: Appearance.colors.colSubtext
        }

        StyledText {
            Layout.fillWidth: true
            Layout.topMargin: 4
            text: Translation.tr(
                      "Edit a shortcut or add a command. Changes are saved in custom/keybinds.lua. Generated shortcuts are shown for reference.")
            font.pixelSize: Appearance.font.pixelSize.smaller
            color: Appearance.colors.colSubtext
            wrapMode: Text.Wrap
        }

        StyledText {
            Layout.fillWidth: true
            visible: page.saveMessage !== ""
            text: page.saveMessage
            wrapMode: Text.Wrap
            color: Appearance.colors.colPrimary
        }

        ContentSubsection {
            objectName: "keybindEditor"
            visible: page.editorOpen
            title: page.editingEntry ? Translation.tr("Edit shortcut") : Translation.tr("New shortcut")
            GroupedList {
                ConfigTextArea {
                    id: nameField
                    objectName: "keybindName"
                    text: Translation.tr("Name")
                    visible: !page.editingEntry
                    placeholderText: Translation.tr("Open terminal")
                    enabled: !page.saving
                }
                ConfigTextArea {
                    id: commandField
                    objectName: "keybindCommand"
                    text: Translation.tr("Command")
                    visible: !page.editingEntry
                    placeholderText: "kitty"
                    enabled: !page.saving
                }
                ConfigTextArea {
                    objectName: "shortcutField"
                    text: Translation.tr("Shortcut")
                    value: page.capturedCombo
                    enabled: !page.capturing && !page.saving
                    onValueChanged: {
                        page.capturedCombo = value;
                        page.captureError = "";
                    }
                    placeholderText: "SUPER + SHIFT + T"
                }
            }
            StyledText {
                Layout.fillWidth: true
                visible: !!page.editingEntry
                text: page.editingEntry ? page.descriptionName(page.editingEntry.description) : ""
                wrapMode: Text.Wrap
                color: Appearance.colors.colSubtext
            }
            FocusScope {
                id: captureArea
                Layout.fillWidth: true
                implicitHeight: page.capturing ? 48 : 0
                visible: page.capturing
                Keys.onPressed: event => page.handleKey(event)
                Rectangle {
                    anchors.fill: parent
                    color: Appearance.colors.colLayer2
                    radius: Appearance.rounding.small
                    StyledText {
                        anchors.centerIn: parent
                        text: Translation.tr("Press a shortcut · Esc to stop")
                        color: Appearance.colors.colPrimary
                    }
                }
            }
            StyledText {
                Layout.fillWidth: true
                visible: page.captureError !== ""
                text: page.captureError
                color: Appearance.colors.colError
                wrapMode: Text.Wrap
            }
            Flow {
                Layout.fillWidth: true
                spacing: 8
                RippleButtonWithIcon {
                    materialIcon: page.capturing ? "stop" : "keyboard"
                    mainText: page.capturing ? Translation.tr("Stop recording") : Translation.tr(
                                                   "Record keys")
                    enabled: !page.saving
                    onClicked: {
                        if (page.capturing)
                            page.stopCapture();
                        else {
                            page.capturing = true;
                            page.captureError = "";
                            captureArea.forceActiveFocus();
                            submapEnter.running = true;
                        }
                    }
                }
                RippleButtonWithIcon {
                    materialIcon: "close"
                    mainText: Translation.tr("Cancel")
                    enabled: !page.saving
                    onClicked: page.closeDialog()
                }
                RippleButtonWithIcon {
                    objectName: "saveKeybind"
                    materialIcon: "check"
                    mainText: page.saving ? Translation.tr("Saving…") : Translation.tr("Save")
                    enabled: !page.saving && !page.capturing && page.capturedCombo.trim() !== ""
                    onClicked: page.applyRebind()
                }
            }
        }

        Repeater {
            model: page.filtered

            Rectangle {
                id: bindRow
                required property var modelData

                Layout.fillWidth: true
                implicitHeight: 72
                radius: Appearance.rounding.small
                opacity: 1
                color: !bindRow.modelData.dynamic && rowMouse.containsMouse
                       ? Appearance.colors.colLayer1Hover : Appearance.colors.colLayer1

                MouseArea {
                    id: rowMouse
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: bindRow.modelData.dynamic ? Qt.ArrowCursor : Qt.PointingHandCursor
                    onClicked: page.startEdit(bindRow.modelData)
                }

                RowLayout {
                    anchors.fill: parent
                    anchors.leftMargin: 12
                    anchors.rightMargin: 8
                    spacing: 12

                    Rectangle {
                        visible: bindRow.width >= 440
                        implicitWidth: Math.min(Math.max(64, comboText.implicitWidth + 20), bindRow.width
                                                * 0.4)
                        implicitHeight: 28
                        radius: Appearance.rounding.small
                        color: Appearance.colors.colLayer2
                        border.width: 1
                        border.color: Appearance.colors.colOutline

                        StyledText {
                            id: comboText
                            anchors.centerIn: parent
                            width: parent.width - 20
                            elide: Text.ElideRight
                            text: page.displayCombo(bindRow.modelData)
                            font {
                                family: Appearance.font.family.monospace
                                pixelSize: Appearance.font.pixelSize.small
                            }
                            color: Appearance.colors.colOnLayer1
                        }
                    }

                    ColumnLayout {
                        Layout.fillWidth: true
                        Layout.minimumWidth: 0
                        spacing: 4

                        StyledText {
                            Layout.fillWidth: true
                            text: page.descriptionName(bindRow.modelData.description)
                            elide: Text.ElideRight
                            font.pixelSize: Appearance.font.pixelSize.normal
                            color: Appearance.colors.colOnLayer1
                        }

                        StyledText {
                            Layout.fillWidth: true
                            text: {
                                const category = page.descriptionCategory(bindRow.modelData.description);
                                const file = page.fileName(bindRow.modelData.path);
                                const base = category === "" ? file : `${category} · ${file}`;
                                const details = bindRow.width < 440 ? page.displayCombo(bindRow.modelData)
                                                                      + " · " + base : base;
                                return bindRow.modelData.dynamic ? `${details} · ${Translation.tr("generated")
                                                                   }` : details;
                            }
                            elide: Text.ElideRight
                            font.pixelSize: Appearance.font.pixelSize.smaller
                            color: Appearance.colors.colSubtext
                        }
                    }

                    MaterialSymbol {
                        text: bindRow.modelData.dynamic ? "code" : "edit"
                        iconSize: 18
                        color: Appearance.colors.colSubtext
                    }
                }
            }
        }

        StyledText {
            Layout.fillWidth: true
            Layout.topMargin: 8
            visible: page.filtered.length === 0
            text: Translation.tr("No keybinds match your search.")
            horizontalAlignment: Text.AlignHCenter
            color: Appearance.colors.colSubtext
        }
    }
}
